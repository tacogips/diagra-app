{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Diagram, ERD and design editor",
    "copyright": "Copyright (c) tacogips",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/diagra-cli"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist"
    },
    "fileAssociations": [
      {
        "ext": [
          "jsonl"
        ],
        "name": "Diagra document",
        "description": "diagra JSONL diagram document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/jsonl"
      },
      {
        "ext": [
          "mmd",
          "mermaid"
        ],
        "name": "Mermaid diagram",
        "description": "Mermaid diagram source",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "bpmn"
        ],
        "name": "BPMN diagram",
        "description": "BPMN 2.0 process diagram",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
